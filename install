#!/usr/bin/env bash
set -euo pipefail

# HiWonder bootstrap. It only fetches the independent runner from this repo.
HIWONDER_URL="${HIWONDER_URL:-https://raw.githubusercontent.com/liangfuyuan581-creator/install/master}"
HIWONDER_DIR="${HIWONDER_DIR:-/tmp/hiwonder-install}"

if [[ "${EUID}" -eq 0 ]]; then
    SUDO=""
else
    SUDO="sudo"
fi

mkdir -p "${HIWONDER_DIR}"
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import argparse' >/dev/null 2>&1; then
    ${SUDO} apt-get update
    DEBIAN_FRONTEND=noninteractive ${SUDO} apt-get install -y python3
fi

if command -v curl >/dev/null 2>&1; then
    curl --fail --silent --show-error --location \
        "${HIWONDER_URL%/}/install.py" \
        --output "${HIWONDER_DIR}/install.py"
elif command -v wget >/dev/null 2>&1; then
    wget --quiet --output-document="${HIWONDER_DIR}/install.py" \
        "${HIWONDER_URL%/}/install.py"
else
    ${SUDO} apt-get update
    DEBIAN_FRONTEND=noninteractive ${SUDO} apt-get install -y curl
    curl --fail --silent --show-error --location \
        "${HIWONDER_URL%/}/install.py" \
        --output "${HIWONDER_DIR}/install.py"
fi

python3 "${HIWONDER_DIR}/install.py" "$@"
