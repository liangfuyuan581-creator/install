#!/usr/bin/env bash
set -euo pipefail

# HiWonder bootstrap. It only fetches the independent runner from this repo.
export LANG="C.UTF-8"
export LC_ALL="C.UTF-8"
export PYTHONIOENCODING="UTF-8"

if [[ -t 1 ]]; then
    stty iutf8 2>/dev/null || true
fi

HIWONDER_URL="${HIWONDER_URL:-https://raw.githubusercontent.com/liangfuyuan581-creator/install/hiwonder-ros2-opencv}"
HIWONDER_DIR="${HIWONDER_DIR:-/tmp/hiwonder-install}"
HIWONDER_CACHE_BUSTER="${HIWONDER_CACHE_BUSTER:-$(date +%s)}"

if [[ "${EUID}" -eq 0 ]]; then
    SUDO=""
else
    SUDO="sudo"
fi

mkdir -p "${HIWONDER_DIR}"
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import argparse' >/dev/null 2>&1; then
    ${SUDO} apt-get update
    DEBIAN_FRONTEND=noninteractive ${SUDO} apt-get install -y python3
fi

if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
    ${SUDO} apt-get update
    DEBIAN_FRONTEND=noninteractive ${SUDO} apt-get install -y curl wget
fi

download_runner() {
    local runner_url="${HIWONDER_URL%/}/install.py?hiwonder=${HIWONDER_CACHE_BUSTER}"

    if command -v curl >/dev/null 2>&1; then
        if curl --fail --silent --show-error --location --http1.1 \
            --retry 5 --retry-all-errors --connect-timeout 15 --max-time 120 \
            "${runner_url}" --output "${HIWONDER_DIR}/install.py"; then
            return 0
        fi
        echo "[HiWonder] curl download failed; trying wget..." >&2
    fi

    if command -v wget >/dev/null 2>&1; then
        if wget --quiet --tries=5 --timeout=30 --waitretry=3 \
            --output-document="${HIWONDER_DIR}/install.py" "${runner_url}"; then
            return 0
        fi
    fi

    echo "[HiWonder] Could not download install.py from ${runner_url}" >&2
    return 1
}

download_runner

python3 "${HIWONDER_DIR}/install.py" "$@"
